{
  "name": "@trs-aip/dsh-knowledge-rag",
  "version": "0.1.1",
  "description": "Local GraphRAG knowledge sidebar and session retrieval tool for DSH",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "third_party",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -b --force && tsdown --config-loader native && node --check lib/index.js && node scripts/check-build.mjs",
    "typecheck": "tsc -b --force --pretty false",
    "test": "node --import tsx --test tests/*.test.ts && node tests/browser.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:packed": "node tests/packed.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-agent-default-model": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-settings": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-app-boot": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.3",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-alpha.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/yauzl": "3.4.0",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "tsdown": "^0.22.2",
    "tsx": "^4.20.0",
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../../../deepseek-harness/vendor/schemastery",
    "@deepseek-ai/dsh-typert-protocol": "link:../../../deepseek-harness/packages/typert/protocol",
    "@deepseek-ai/dsh-api-remotes": "link:../../../deepseek-harness/packages/api/remotes",
    "@deepseek-ai/dsh-llm": "link:../../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-agent": "link:../../../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-agent-default-model": "link:../../../deepseek-harness/packages/core/agent-default-model",
    "@deepseek-ai/dsh-settings": "link:../../../deepseek-harness/packages/settings/settings",
    "@deepseek-ai/dsh-credentials": "link:../../../deepseek-harness/packages/credentials/credentials",
    "@deepseek-ai/dsh-tools": "link:../../../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-system-prompt": "link:../../../deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-app-boot": "link:../../../deepseek-harness/packages/boot/app-boot",
    "@deepseek-ai/dsh-session": "link:../../../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "link:../../../deepseek-harness/packages/client/ui-sidebar-right",
    "@deepseek-ai/dsh-client-ui-settings": "link:../../../deepseek-harness/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-layout": "link:../../../deepseek-harness/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../../deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-api-remote-access": "link:../../../deepseek-harness/packages/api/remote-access",
    "playwright": "1.64.1",
    "esbuild": "^0.28.2",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "fs-ext-extra-prebuilt": "2.2.14",
    "js-tiktoken": "1.0.21",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.4.299",
    "remark-parse": "11.0.0",
    "saxes": "6.0.0",
    "unified": "11.0.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7",
    "react-markdown": "10.1.0"
  }
}
